<Window x:Class="FluentLyrics.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes de FluentLyrics" 
        Height="620" Width="490"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B0D13"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI Variable Display"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderThickness="1"
        BorderBrush="#252D3D">

    <Window.Resources>
        <!-- Modern Toggle Switch Style for CheckBoxes -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            
                            <!-- Toggle Pill Container -->
                            <Border x:Name="ToggleTrack" Grid.Column="1" Width="38" Height="20" CornerRadius="10" Background="#1E2330" BorderThickness="1" BorderBrush="#2F384C">
                                <Ellipse x:Name="ToggleThumb" Width="14" Height="14" Fill="#7E8B9B" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="#00F0FF"/>
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#00F0FF"/>
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="ToggleThumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="#0B0D13"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#00F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab Button Style -->
        <Style x:Key="TabPillButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A99AD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C2333"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#11141D"/>
            <Setter Property="BorderBrush" Value="#1E2535"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Color Swatch Circle Button Style -->
        <Style x:Key="ColorSwatch" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}" BorderThickness="2" BorderBrush="#33FFFFFF">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#0A0C12" MouseLeftButtonDown="Window_Header_MouseDown">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Minimalist Cyberpunk Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Mini Logo / Glyph -->
                    <Border Width="28" Height="28" CornerRadius="6" Background="#161B28" BorderBrush="#00F0FF" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="14" Foreground="#00F0FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FluentLyrics" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border Background="#1A2836" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.3.0" FontSize="10" FontWeight="Bold" Foreground="#00F0FF"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Configuración y Personalización Minimalista" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="1" Click="BtnCancel_Click" Background="Transparent" BorderThickness="0" Foreground="#64748B" Cursor="Hand" Width="28" Height="28">
                    <TextBlock Text="✕" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 2. Segmented Pill Navigation Tabs -->
            <Border Grid.Row="1" Background="#0F131D" CornerRadius="18" Padding="3" Margin="0,0,0,14" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabVisual" Content="🎨 Visual &amp; RGB" Style="{StaticResource TabPillButton}" IsChecked="True" Checked="Tab_Changed"/>
                    <RadioButton x:Name="TabTaskbar" Content="📌 Barra de Tareas" Style="{StaticResource TabPillButton}" Checked="Tab_Changed"/>
                    <RadioButton x:Name="TabGeneral" Content="⚙️ Ajustes" Style="{StaticResource TabPillButton}" Checked="Tab_Changed"/>
                </StackPanel>
            </Border>

            <!-- 3. Scrollable Tab Contents -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,4,0">
                    
                    <!-- TAB 1: Visual & RGB -->
                    <StackPanel x:Name="PanelVisual" Visibility="Visible">
                        
                        <!-- CARD: Modo RGB Chroma (TikTok / Cyberpunk) -->
                        <Border Style="{StaticResource GlassCard}" BorderBrush="#00F0FF" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌈" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Modo RGB Chroma (Dinámico)" FontWeight="Bold" FontSize="13" Foreground="#00F0FF"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkRgbMode" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Right" Checked="ChkRgbMode_Toggled" Unchecked="ChkRgbMode_Toggled"/>
                                </Grid>
                                <TextBlock Text="Cicla colores vibrantes en tiempo real con 0.0% de consumo de CPU." FontSize="11" Foreground="#8A99AD" Margin="0,0,0,10"/>

                                <Grid Margin="0,4,0,2">
                                    <TextBlock Text="Velocidad del Ciclo RGB:" FontSize="12" Foreground="#CBD5E1"/>
                                    <TextBlock x:Name="TxtRgbSpeedVal" Text="5x" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderRgbSpeed" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderRgbSpeed_ValueChanged"/>

                                <TextBlock Text="Estilo de Animación RGB:" FontSize="12" Foreground="#CBD5E1" Margin="0,6,0,4"/>
                                <ComboBox x:Name="CmbRgbStyle" Background="#161B28" Foreground="#FFFFFF" BorderBrush="#252D3D" Height="30">
                                    <ComboBoxItem Content="Smooth Rainbow (Arcoíris Fluido)" Tag="SmoothRainbow"/>
                                    <ComboBoxItem Content="Cyberpunk Chroma (Neón Futurista)" Tag="CyberChroma"/>
                                    <ComboBoxItem Content="Pulse Beat (Transición Pulsante)" Tag="RandomPulse"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- CARD: Tipografía & Color Estático -->
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock Text="🎨 Color Estático &amp; Tipografía" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                
                                <TextBlock Text="Paleta Rápida de Colores:" FontSize="12" Foreground="#8A99AD" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Background="#00F0FF" Style="{StaticResource ColorSwatch}" Click="BtnColorQuick_Click" Tag="#00F0FF" ToolTip="Cian Eléctrico"/>
                                    <Button Background="#1DB954" Style="{StaticResource ColorSwatch}" Click="BtnColorQuick_Click" Tag="#1DB954" ToolTip="Spotify Verde"/>
                                    <Button Background="#FF007F" Style="{StaticResource ColorSwatch}" Click="BtnColorQuick_Click" Tag="#FF007F" ToolTip="Rosa Neón"/>
                                    <Button Background="#9D00FF" Style="{StaticResource ColorSwatch}" Click="BtnColorQuick_Click" Tag="#9D00FF" ToolTip="Púrpura Neón"/>
                                    <Button Background="#FFE600" Style="{StaticResource ColorSwatch}" Click="BtnColorQuick_Click" Tag="#FFE600" ToolTip="Dorado Brillante"/>
                                    <Button Background="#FFFFFF" Style="{StaticResource ColorSwatch}" Click="BtnColorQuick_Click" Tag="#FFFFFF" ToolTip="Blanco Puro"/>
                                    <TextBox x:Name="TxtCustomColor" Width="80" Height="24" Background="#161B28" Foreground="#00F0FF" BorderBrush="#252D3D" Text="#00F0FF" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="11" Margin="6,0,0,0"/>
                                </StackPanel>

                                <Grid Margin="0,4,0,2">
                                    <TextBlock Text="Tamaño de Fuente:" FontSize="12" Foreground="#CBD5E1"/>
                                    <TextBlock x:Name="TxtFontSizeVal" Text="15 pt" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderFontSize" Minimum="12" Maximum="24" Value="15" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderFontSize_ValueChanged"/>

                                <CheckBox x:Name="ChkGlow" Content="Resplandor / Brillo neón en el texto" Style="{StaticResource ModernToggleSwitch}"/>
                            </StackPanel>
                        </Border>

                        <!-- CARD: Fondo y Transparencia -->
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock Text="🪟 Fondo y Bordes" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                
                                <TextBlock Text="Efecto de Fondo:" FontSize="12" Foreground="#8A99AD" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbTheme" Background="#161B28" Foreground="#FFFFFF" BorderBrush="#252D3D" Height="30" Margin="0,0,0,8">
                                    <ComboBoxItem Content="Transparent (Puro Texto Flotante)" Tag="Transparent"/>
                                    <ComboBoxItem Content="DarkGlass (Vidrio Obsidiana)" Tag="DarkGlass"/>
                                    <ComboBoxItem Content="Acrylic (Acrílico Blur Windows 11)" Tag="Acrylic"/>
                                    <ComboBoxItem Content="Mica (Efecto Windows 11)" Tag="Mica"/>
                                    <ComboBoxItem Content="LightGlass (Vidrio Claro)" Tag="LightGlass"/>
                                </ComboBox>

                                <CheckBox x:Name="ChkShowBorder" Content="Mostrar borde exterior del contenedor" Style="{StaticResource ModernToggleSwitch}"/>
                                <CheckBox x:Name="ChkShowDot" Content="Mostrar punto indicador circular" Style="{StaticResource ModernToggleSwitch}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- TAB 2: Barra de Tareas -->
                    <StackPanel x:Name="PanelTaskbar" Visibility="Collapsed">
                        
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock Text="📌 Anclaje Estático (Windows 11)" FontWeight="Bold" FontSize="13" Foreground="#00F0FF" Margin="0,0,0,4"/>
                                <TextBlock Text="Encaja perfectamente en la barra de tareas al lado de FluentFlyouts." FontSize="11" Foreground="#8A99AD" Margin="0,0,0,10"/>

                                <CheckBox x:Name="ChkTaskbarDock" Content="Anclar fijamente a la barra de tareas" Style="{StaticResource ModernToggleSwitch}"/>
                                <CheckBox x:Name="ChkTaskbarCompact" Content="Modo 1 sola línea (ahorra espacio vertical)" Style="{StaticResource ModernToggleSwitch}"/>

                                <Grid Margin="0,10,0,2">
                                    <TextBlock Text="Distancia desde la bandeja (Offset px):" FontSize="12" Foreground="#CBD5E1"/>
                                    <TextBlock x:Name="TxtTaskbarOffsetVal" Text="220 px" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderTaskbarOffset" Minimum="0" Maximum="600" Value="220" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SliderTaskbarOffset_ValueChanged"/>

                                <Grid Margin="0,6,0,2">
                                    <TextBlock Text="Ancho máximo (evita tapar aplicaciones):" FontSize="12" Foreground="#CBD5E1"/>
                                    <TextBlock x:Name="TxtTaskbarMaxWVal" Text="340 px" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderTaskbarMaxW" Minimum="180" Maximum="500" Value="340" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="SliderTaskbarMaxW_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock Text="✨ Modo One Word (TikTok / Reels)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="Las palabras salen una por una al compás de la voz." FontSize="11" Foreground="#8A99AD" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkOneWord" Content="Activar modo palabra por palabra" Style="{StaticResource ModernToggleSwitch}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- TAB 3: Ajustes Generales -->
                    <StackPanel x:Name="PanelGeneral" Visibility="Collapsed">
                        
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock Text="⚙️ Comportamiento e Interacción" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                
                                <CheckBox x:Name="ChkClickThrough" Content="Modo Fantasma (clics atraviesan el widget)" Style="{StaticResource ModernToggleSwitch}"/>
                                <CheckBox x:Name="ChkAlwaysOnTop" Content="Mantener siempre encima de otras ventanas" Style="{StaticResource ModernToggleSwitch}"/>
                                <CheckBox x:Name="ChkAutoHide" Content="Ocultar automáticamente al pausar Spotify" Style="{StaticResource ModernToggleSwitch}"/>
                                <CheckBox x:Name="ChkNextLine" Content="Mostrar siguiente estrofa en modo flotante" Style="{StaticResource ModernToggleSwitch}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock Text="⏱️ Calibración de Tiempo (Offset)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="Ajusta milisegundos si la letra va adelantada o retrasada." FontSize="11" Foreground="#8A99AD" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,4,0,2">
                                    <TextBlock Text="Desfase Temporal:" FontSize="12" Foreground="#CBD5E1"/>
                                    <TextBlock x:Name="TxtOffsetVal" Text="0 ms" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderOffset" Minimum="-2000" Maximum="2000" Value="0" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="SliderOffset_ValueChanged"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- 4. Footer Actions -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Button Content="Restablecer" Click="BtnResetPosition_Click" Background="Transparent" Foreground="#64748B" BorderThickness="0" FontSize="12" Cursor="Hand" HorizontalAlignment="Left"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Click="BtnCancel_Click" Background="#161B28" Foreground="#CBD5E1" BorderBrush="#252D3D" BorderThickness="1" Padding="14,7" FontSize="12" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Content="Guardar y Aplicar" Click="BtnSave_Click" Background="#00F0FF" Foreground="#0B0D13" FontWeight="Bold" BorderThickness="0" Padding="18,7" FontSize="12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
